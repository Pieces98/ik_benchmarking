<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ik_benchmarking</name>
  <version>0.0.0</version>
  <description>IK solver benchmarking utility for the MoveIt Pro container. The launch file reads URDF (xacro-expanded) and SRDF from disk and injects them as robot_description / robot_description_semantic parameters on the server node, which builds the robot model via MoveIt Pro's RobotModelLoader — no running /move_group needed.</description>
  <maintainer email="yunbeom.kim@wattrobotics.ai">Yunbeom Kim</maintainer>
  <license>
    Apache License, Version 2.0
    http://www.apache.org/licenses/LICENSE-2.0
  </license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>action_msgs</depend>
  <depend>fmt</depend>
  <depend>moveit_core</depend>
  <depend>moveit_pro_base</depend>
  <depend>pose_ik</depend>
  <depend>pro_rrt</depend>
  <depend>random_numbers</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclpy</depend>

  <!-- Visualizer script depends on these Python libraries at runtime. -->
  <exec_depend>python3-pandas</exec_depend>
  <exec_depend>python3-seaborn</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
